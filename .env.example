# Default provider: deepseek
AI_PROVIDER=deepseek

# Provider-agnostic overrides. If set, these take precedence over
# provider-specific variables, and can be used to connect any
# OpenAI-compatible endpoint.
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_REASONING_MODEL=

# Optional capability switches for OpenAI-compatible providers.
# deepseek default: supports stream_options + uses object response_format
AI_SUPPORTS_STREAM_OPTIONS=
AI_JSON_RESPONSE_FORMAT_MODE=

# DeepSeek configuration
# 获取方式：访问 https://platform.deepseek.com/ 注册账号并获取 API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
