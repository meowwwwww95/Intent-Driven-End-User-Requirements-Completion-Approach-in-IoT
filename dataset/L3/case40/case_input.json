        },
        {
          "name": "switch_heating_mode()",
          "description": "将空调模式设置成制热，以提高环境温度",
          "capabilityType": "action"
        },
        {
          "name": "switch_dry_mode()",
          "description": "将空调模式设置成除湿，以降低环境湿度",
          "capabilityType": "action"
        },
        {
          "name": "low_fan_speed()",
          "description": "将空调风速设置为低",
          "capabilityType": "action"
