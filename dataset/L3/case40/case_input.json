{
  "user_input": [
    "IF sprite_temperature_humidity_sensor_KD30.get_temperature() > 28 THEN switch_cooling_mode() NWT_Internet_Mobile_Air_Conditioner",
    "IF qingping_air_monitor.reading_PM2_5() > 77 THEN turn_on() xiaomi_air_purifier",
    "IF sprite_temperature_humidity_sensor_KD30.get_humidity() < 22 THEN turn_on() zhimi_humidifier"
  ],
  "env_profile": [
        {
      "name": "NWT_Internet_Mobile_Air_Conditioner",
      "type": "air_conditioner",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "开启空调",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭空调",
          "capabilityType": "action"
        },
        {
          "name": "switch_cooling_mode()",
          "description": "将空调模式设置成制冷，以提高环境温度",
