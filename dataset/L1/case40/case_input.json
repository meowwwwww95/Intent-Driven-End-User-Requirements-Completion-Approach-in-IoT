{
  "user_input": [
    "IF aqara_sound_sensor.reading() > 40 THEN set_volume_low() xiaomi_television",
    "IF yunmi_water_purifier.tds_in() < 93 THEN filter_water() yunmi_water_purifier"
  ],
  "env_profile": [
    {
      "name": "aqara_alarm",
      "type": "alarm",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_smoke_sensor",
      "type": "smoke_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的烟雾浓度",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "xiaomi_television",
      "type": "television",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开电视",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭电视",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_high()",
          "description": "将电视的音量调高",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_low()",
          "description": "将电视的音量调低",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_sound_sensor",
      "type": "volume_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的音量，单位为dB",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
