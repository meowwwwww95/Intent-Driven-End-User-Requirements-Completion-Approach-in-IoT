{
  "user_input": [
    "IF aqara_sound_sensor.reading() < 42 THEN turn_high_volume() X_stereo",
    "IF yunmi_water_purifier.tds_in() < 60 THEN filter_water() yunmi_water_purifier"
  ],
  "env_profile": [
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "X_stereo",
      "type": "stereo",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开立体声",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭立体声",
          "capabilityType": "action"
        },
        {
          "name": "turn_high_volume()",
          "description": "将立体声的音量调高",
          "capabilityType": "action"
        },
        {
          "name": "turn_low_volume()",
          "description": "将立体声的音量调低",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_sound_sensor",
      "type": "volume_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的音量，单位为dB",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}