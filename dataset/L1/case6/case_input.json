{
  "user_input": [
    "IF xiaomi_volume_sensor.reading() > 66 THEN set_volume_low() xiaomi_television"
  ],
  "env_profile": [
    {
      "name": "xiaomi_television",
      "type": "television",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开电视",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭电视",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_high()",
          "description": "将电视的音量调高",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_low()",
          "description": "将电视的音量调低",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "xiaomi_volume_sensor",
      "type": "volume_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的音量，单位为dB",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}