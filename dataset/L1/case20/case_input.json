{
  "user_input": [
    "IF xiaomi_humidity_sensor.relative_humidity() > 73 THEN turn_on() xiaomi_dehumidifier",
    "IF yunmi_water_purifier.tds_in() < 76 THEN filter_water() yunmi_water_purifier"
  ],
  "env_profile": [
    {
      "name": "xiaomi_dehumidifier",
      "type": "dehumidifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开除湿器",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭除湿器",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "xiaomi_humidity_sensor",
      "type": "humidity_sensor",
      "capabilities": [
        {
          "name": "relative_humidity()",
          "description": "可以获取到当前的湿度",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}