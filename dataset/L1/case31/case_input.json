{
  "user_input": [
    "IF yunmi_water_purifier.tds_in() < 72 THEN filter_water() yunmi_water_purifier",
    "IF viomi_hood.reading() > 8 THEN power_on() viomi_hood"
  ],
  "env_profile": [
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "viomi_hood",
      "type": "hood",
      "capabilities": [
        {
          "name": "power_on()",
          "description": "打开抽油烟机",
          "capabilityType": "action"
        },
        {
          "name": "power_off()",
          "description": "关闭抽油烟机",
          "capabilityType": "action"
        },
        {
          "name": "reading()",
          "description": "返回油烟浓度，以%为单位",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}