{
  "user_input": [
    "IF qingping_air_monitor.reading_PM2_5() < 100 THEN turn_on() xiaomi_air_purifier"
  ],
  "env_profile": [
    {
      "name": "xiaomi_air_purifier",
      "type": "air_purifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "开启空气净化器以提高空气质量",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭空气净化器",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "qingping_air_monitor",
      "type": "air_quality_sensor",
      "capabilities": [
        {
          "name": "reading_PM2_5()",
          "description": "读取当前PM2.5值，单位ppm",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_humidity()",
          "description": "读取当前湿度，单位%",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_temperature()",
          "description": "读取当前温度，单位℃",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}