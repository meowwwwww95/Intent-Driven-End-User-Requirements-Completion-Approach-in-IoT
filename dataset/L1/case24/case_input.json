{
  "user_input": [
    "IF aqara_human_sensor.reading() != 人在家 THEN start_sweep() viomi_vacuum",
    "IF yunmi_water_purifier.tds_in() < 73 THEN filter_water() yunmi_water_purifier"
  ],
  "env_profile": [
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_human_sensor",
      "type": "human_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "检测屋内是否有人，如果有人则返回'人在家'，无人则返回'人离开'",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "viomi_vacuum",
      "type": "vacuum",
      "capabilities": [
        {
          "name": "start_sweep()",
          "description": "开始清扫",
          "capabilityType": "action"
        },
        {
          "name": "stop_sweeping()",
          "description": "停止清扫",
          "capabilityType": "action"
        }
      ]
    }
  ]
}