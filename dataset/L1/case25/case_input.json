{
  "user_input": [
    "IF aqara_human_sensor.reading() == '人离开' THEN start_sweep() viomi_vacuum"
  ],
  "env_profile": [
    {
      "name": "aqara_human_sensor",
      "type": "human_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "检测屋内是否有人，如果有人则返回'人在家'，无人则返回'人离开'",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "viomi_vacuum",
      "type": "vacuum",
      "capabilities": [
        {
          "name": "start_sweep()",
          "description": "开始清扫",
          "capabilityType": "action"
        },
        {
          "name": "stop_sweeping()",
          "description": "停止清扫",
          "capabilityType": "action"
        }
      ]
    }
  ]
}