{
  "user_input": [
    "IF xiaomi_humidity_sensor.relative_humidity() > 55 THEN turn_on() xiaomi_dehumidifier",
    "IF aqara_human_sensor.reading() != 人在家 THEN start_sweep() viomi_vacuum"
  ],
  "env_profile": [
    {
      "name": "xiaomi_dehumidifier",
      "type": "dehumidifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开除湿器",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭除湿器",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_human_sensor",
      "type": "human_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "检测屋内是否有人，如果有人则返回'人在家'，无人则返回'人离开'",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "xiaomi_humidity_sensor",
      "type": "humidity_sensor",
      "capabilities": [
        {
          "name": "relative_humidity()",
          "description": "可以获取到当前的湿度",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "viomi_vacuum",
      "type": "vacuum",
      "capabilities": [
        {
          "name": "start_sweep()",
          "description": "开始清扫",
          "capabilityType": "action"
        },
        {
          "name": "stop_sweeping()",
          "description": "停止清扫",
          "capabilityType": "action"
        }
      ]
    }
  ]
}