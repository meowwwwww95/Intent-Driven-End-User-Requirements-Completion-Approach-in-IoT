{
  "user_input": [
    "IF aqara_sound_sensor.reading() > 43 THEN set_volume_low() xiaomi_television",
    "IF aqara_human_sensor.reading() == 人在家 THEN turn_on() xiaomi_diffuser"
  ],
  "env_profile": [
    {
      "name": "xiaomi_diffuser",
      "type": "diffuser",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开香氛机",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭香氛机",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_human_sensor",
      "type": "human_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "检测屋内是否有人，如果有人则返回'人在家'，无人则返回'人离开'",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "xiaomi_television",
      "type": "television",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开电视",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭电视",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_high()",
          "description": "将电视的音量调高",
          "capabilityType": "action"
        },
        {
          "name": "set_volume_low()",
          "description": "将电视的音量调低",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_sound_sensor",
      "type": "volume_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的音量，单位为dB",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}