{
  "user_input": [
    "IF LG_brightness_sensor.get_brightness() < 538 THEN turn_light_up() philips_zhiyi_light",
    "IF xiaomi_volume_sensor.reading() > 74 THEN turn_low_volume() X_stereo",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum"
  ],
  "env_profile": [
    {
      "name": "LG_brightness_sensor",
      "type": "brightness_sensor",
      "capabilities": [
        {
          "name": "get_brightness()",
          "description": "可以获取到当前的亮度",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "Blade_Star_smart_door",
      "type": "door",
      "capabilities": [
        {
          "name": "is_door_open()",
          "description": "判断门是否打开",
          "capabilityType": "trigger"
        },
        {
          "name": "is_door_locked()",
          "description": "判断门是否进行门外一键上锁",
          "capabilityType": "trigger"
        },
        {
          "name": "record()",
          "description": "录制视频",
          "capabilityType": "trigger"
        },
        {
          "name": "open_door()",
          "description": "打开门",
          "capabilityType": "action"
        },
        {
          "name": "close_door()",
          "description": "关闭门",
          "capabilityType": "action"
        },
        {
          "name": "lock_door()",
          "description": "上锁门",
          "capabilityType": "action"
        },
        {
          "name": "unlock_door()",
          "description": "解锁门",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "LG_fire_detector",
      "type": "fire_detector",
      "capabilities": [
        {
          "name": "is_fire()",
          "description": "可以获取到当前是否着火，如果着火返回true，否则返回false",
          "capabilityType": "trigger"
        },
        {
          "name": "beep()",
          "description": "蜂鸣提示当前发生火灾",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "philips_zhiyi_light",
      "type": "light",
      "capabilities": [
        {
          "name": "turn_light_on()",
          "description": "开灯",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_off()",
          "description": "关灯",
          "capabilityType": "action"
        },
        {
          "name": "switch_children_mode()",
          "description": "调至儿童看书模式",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_up()",
          "description": "提升亮度",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_down()",
          "description": "降低亮度",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_motion_sensor",
      "type": "motion_sensor",
      "capabilities": [
        {
          "name": "motion_state()",
          "description": "检测是否有人经过，如果有人则返回true，无人则返回false",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "X_stereo",
      "type": "stereo",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "打开立体声",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭立体声",
          "capabilityType": "action"
        },
        {
          "name": "turn_high_volume()",
          "description": "将立体声的音量调高",
          "capabilityType": "action"
        },
        {
          "name": "turn_low_volume()",
          "description": "将立体声的音量调低",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "viomi_vacuum",
      "type": "vacuum",
      "capabilities": [
        {
          "name": "start_sweep()",
          "description": "开始清扫",
          "capabilityType": "action"
        },
        {
          "name": "stop_sweeping()",
          "description": "停止清扫",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "xiaomi_volume_sensor",
      "type": "volume_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的音量，单位为dB",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}