{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 497 THEN brightness_up() wotie_brightness_sensor",
    "IF qingping_air_monitor.reading_PM2_5() < 100 THEN turn_on() xiaomi_air_purifier"
  ],
  "env_profile": [
    {
      "name": "xiaomi_air_conditioner",
      "type": "air_conditioner",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到“制冷模式”、“制热模式”或是“已关闭”",
          "capabilityType": "trigger"
        },
        {
          "name": "turn_cool_on()",
          "description": "",
          "capabilityType": "action"
        },
        {
          "name": "turn_heat_on()",
          "description": "",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "xiaomi_air_purifier",
      "type": "air_purifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "开启空气净化器以提高空气质量",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭空气净化器",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "qingping_air_monitor",
      "type": "air_quality_sensor",
      "capabilities": [
        {
          "name": "reading_PM2_5()",
          "description": "读取当前PM2.5值，单位ppm",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_humidity()",
          "description": "读取当前湿度，单位%",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_temperature()",
          "description": "读取当前温度，单位℃",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "wotie_brightness_sensor",
      "type": "brightness_sensor",
      "capabilities": [
        {
          "name": "brightness()",
          "description": "可以获取到当前的亮度",
          "capabilityType": "trigger"
        },
        {
          "name": "brightness_up()",
          "description": "增加亮度",
          "capabilityType": "action"
        },
        {
          "name": "brightness_down()",
          "description": "减少亮度",
          "capabilityType": "action"
        },
        {
          "name": "light_on()",
          "description": "打开灯",
          "capabilityType": "action"
        },
        {
          "name": "light_off()",
          "description": "关闭灯",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "LG_fire_detector",
      "type": "fire_detector",
      "capabilities": [
        {
          "name": "is_fire()",
          "description": "可以获取到当前是否着火，如果着火返回true，否则返回false",
          "capabilityType": "trigger"
        },
        {
          "name": "beep()",
          "description": "蜂鸣提示当前发生火灾",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_human_sensor",
      "type": "human_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "检测屋内是否有人，如果有人则返回'人在家'，无人则返回'人离开'",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}