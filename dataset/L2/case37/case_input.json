{
  "user_input": [
    "IF miaomiao_air_monitor.reading(air_quality) <= 78 THEN turn_on() xiaomi_air_purifier",
    "IF yunmi_water_purifier.tds_in() < 70 THEN filter_water() yunmi_water_purifier"
  ],
  "env_profile": [
    {
      "name": "xiaomi_air_purifier",
      "type": "air_purifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "开启空气净化器以提高空气质量",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关闭空气净化器",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "miaomiao_air_monitor",
      "type": "air_quality_sensor",
      "capabilities": [
        {
          "name": "reading(air_quality)",
          "description": "读取当前空气质量，百分制，空气质量越高，分数越高",
          "capabilityType": "trigger"
        },
        {
          "name": "reading(HCHODesity)",
          "description": "读取当前甲醛值，单位ppm",
          "capabilityType": "trigger"
        },
        {
          "name": "reading(pm2.5Density)",
          "description": "读取当前PM2.5值，单位ppm",
          "capabilityType": "trigger"
        },
        {
          "name": "reading(RelativeHumidity)",
          "description": "读取当前湿度，单位%",
          "capabilityType": "trigger"
        },
        {
          "name": "reading(Temperature)",
          "description": "读取当前温度，单位℃",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "aqara_alarm",
      "type": "alarm",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "yunmi_water_purifier",
      "type": "filter",
      "capabilities": [
        {
          "name": "get_temperature()",
          "description": "获取当前水温信息，单位为℃",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_in()",
          "description": "获取当前入水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "tds_out()",
          "description": "获取当前出水水质信息，百分制，分数越高，水质越好",
          "capabilityType": "trigger"
        },
        {
          "name": "filter_life()",
          "description": "获取当前滤芯剩余寿命信息，百分制，分数越高，代表剩余寿命越长",
          "capabilityType": "trigger"
        },
        {
          "name": "heat_water()",
          "description": "加热水，提高当前水温",
          "capabilityType": "action"
        },
        {
          "name": "filter_water()",
          "description": "过滤水，提高水质分数",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_smoke_sensor",
      "type": "smoke_sensor",
      "capabilities": [
        {
          "name": "reading()",
          "description": "可以获取到当前的烟雾浓度",
          "capabilityType": "trigger"
        }
      ]
    }
  ]
}