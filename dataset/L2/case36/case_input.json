{
  "user_input": [
    "IF LG_brightness_sensor.get_brightness() < 436 THEN turn_light_up() philips_zhiyi_light",
    "IF qingping_air_monitor.reading_PM2_5() > 33 THEN turn_on() mijia_air_purifier",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum"
  ],
  "env_profile": [
    {
      "name": "mijia_air_purifier",
      "type": "air_purifier",
      "capabilities": [
        {
          "name": "turn_on()",
          "description": "开机",
          "capabilityType": "action"
        },
        {
          "name": "turn_off()",
          "description": "关机",
          "capabilityType": "action"
        },
        {
          "name": "set_mode_to_1()",
          "description": "调至1挡",
          "capabilityType": "action"
        },
        {
          "name": "set_mode_to_2()",
          "description": "调至2挡",
          "capabilityType": "action"
        },
        {
          "name": "set_mode_to_3()",
          "description": "调至3挡",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "qingping_air_monitor",
      "type": "air_quality_sensor",
      "capabilities": [
        {
          "name": "reading_PM2_5()",
          "description": "读取当前PM2.5值，单位ppm",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_humidity()",
          "description": "读取当前湿度，单位%",
          "capabilityType": "trigger"
        },
        {
          "name": "reading_temperature()",
          "description": "读取当前温度，单位℃",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "LG_brightness_sensor",
      "type": "brightness_sensor",
      "capabilities": [
        {
          "name": "get_brightness()",
          "description": "可以获取到当前的亮度",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "Blade_Star_smart_door",
      "type": "door",
      "capabilities": [
        {
          "name": "is_door_open()",
          "description": "判断门是否打开",
          "capabilityType": "trigger"
        },
        {
          "name": "is_door_locked()",
          "description": "判断门是否进行门外一键上锁",
          "capabilityType": "trigger"
        },
        {
          "name": "record()",
          "description": "录制视频",
          "capabilityType": "trigger"
        },
        {
          "name": "open_door()",
          "description": "打开门",
          "capabilityType": "action"
        },
        {
          "name": "close_door()",
          "description": "关闭门",
          "capabilityType": "action"
        },
        {
          "name": "lock_door()",
          "description": "上锁门",
          "capabilityType": "action"
        },
        {
          "name": "unlock_door()",
          "description": "解锁门",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "LG_fire_detector",
      "type": "fire_detector",
      "capabilities": [
        {
          "name": "is_fire()",
          "description": "可以获取到当前是否着火，如果着火返回true，否则返回false",
          "capabilityType": "trigger"
        },
        {
          "name": "beep()",
          "description": "蜂鸣提示当前发生火灾",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "philips_zhiyi_light",
      "type": "light",
      "capabilities": [
        {
          "name": "turn_light_on()",
          "description": "开灯",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_off()",
          "description": "关灯",
          "capabilityType": "action"
        },
        {
          "name": "switch_children_mode()",
          "description": "调至儿童看书模式",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_up()",
          "description": "提升亮度",
          "capabilityType": "action"
        },
        {
          "name": "turn_light_down()",
          "description": "降低亮度",
          "capabilityType": "action"
        }
      ]
    },
    {
      "name": "aqara_motion_sensor",
      "type": "motion_sensor",
      "capabilities": [
        {
          "name": "motion_state()",
          "description": "检测是否有人经过，如果有人则返回true，无人则返回false",
          "capabilityType": "trigger"
        }
      ]
    },
    {
      "name": "viomi_vacuum",
      "type": "vacuum",
      "capabilities": [
        {
          "name": "start_sweep()",
          "description": "开始清扫",
          "capabilityType": "action"
