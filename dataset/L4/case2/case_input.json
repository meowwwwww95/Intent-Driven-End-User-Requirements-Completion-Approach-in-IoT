{
  "user_input": [
    "IF aqara_motion_sensor.motion_state() == true THEN light_up() xiaomi_smart_light",
    "IF qingping_air_monitor.reading_temperature() > 21 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF qingping_air_monitor.reading_PM2_5() < 70 THEN turn_on() zhimi_air_fresh",
    "IF xiaomi_volume_sensor.reading() > 28 THEN motor_control(2) babai_curtain",
    "IF qingping_air_monitor.reading_humidity() > 68 THEN turn_on() xiaomi_dehumidifier-"
