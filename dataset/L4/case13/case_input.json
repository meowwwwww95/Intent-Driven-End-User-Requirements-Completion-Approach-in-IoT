    "IF aqara_temperature_sensor.reading() > 25 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF miaomiao_air_monitor.reading(pm2.5Density) > 88 THEN turn_on() zhimi_air_fresh",
    "IF yunmi_water_purifier.tds_in() < 79 THEN turn_on() yunmi_water_purifier"
