{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 521 THEN brightness_up() wotie_brightness_sensor",
    "IF aqara_temperature_sensor.reading() > 23 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF miaomiao_air_monitor.reading(air_quality) < 67 THEN turn_on() zhimi_air_fresh",
    "IF xiaomi_humidity_sensor.relative_humidity() > 47 THEN turn_on() xiaomi_dehumidifier"
