{
  "user_input": [
    "IF LG_brightness_sensor.get_brightness() < 315 THEN light_up() xiaomi_smart_light",
    "IF aqara_temperature_sensor.reading() > 26 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF qingping_air_monitor.reading_PM2_5() < 70 THEN turn_on() zhimi_air_fresh",
    "IF aqara_human_sensor.reading() == 人在家 THEN set_volume_low() xiaomi_television",
    "IF xiaomi_humidity_sensor.relative_humidity() < 21 THEN turn_on() zhimi_humidifier",
    "IF aqara_human_sensor.reading() == 人离开 THEN start_sweep() viomi_vacuum",
    "IF aqara_smoke_sensor.reading() > 0.11 THEN power_on() viomi_hood"
  ],
