{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 725 THEN brightness_up() wotie_brightness_sensor",
    "IF aqara_temperature_sensor.reading() > 23 THEN set_mode_to_cool() smart_inverter_air_conditioner",
    "IF mijia_CO2_ultra_sensor.get_CO2_concentration() > 20 THEN turn_on() zhimi_air_fresh",
    "IF aqara_motion_sensor.motion_state() == true THEN set_volume_low() xiaomi_television",
    "IF xiaomi_humidity_sensor.relative_humidity() < 35 THEN turn_on() zhimi_humidifier",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum",
    "IF aqara_motion_sensor.motion_state() == true THEN turn_on() xiaomi_diffuser"
