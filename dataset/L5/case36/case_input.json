{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 1212 THEN brightness_up() wotie_brightness_sensor",
    "IF aqara_temperature_sensor.reading() > 32 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF miaomiao_air_monitor.reading(pm2.5Density) >= 157 THEN turn_on() zhimi_air_fresh",
    "IF xiaomi_volume_sensor.reading() > 68 THEN motor_control(2) babai_curtain",
    "IF xiaomi_humidity_sensor.relative_humidity() > 68 THEN turn_on() xiaomi_dehumidifier",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum",
    "IF aqara_motion_sensor.motion_state() == true THEN turn_on() xiaomi_diffuser",
    "IF yunmi_water_purifier.tds_in() <= 89 THEN turn_on() yunmi_water_purifier",
    "IF aqara_smoke_sensor.reading() >= 0.38 THEN power_on() viomi_hood"
  ],
