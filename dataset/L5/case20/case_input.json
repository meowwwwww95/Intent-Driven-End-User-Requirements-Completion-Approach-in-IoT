    "IF xiaomi_air_quality_sensor.get_air_score() < 58 THEN turn_on() xiaomi_air_purifier",
    "IF xiaomi_humidity_sensor.relative_humidity() < 52 THEN turn_on() zhimi_humidifier",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum",
    "IF aqara_motion_sensor.motion_state() == true THEN turn_on() xiaomi_diffuser",
    "IF yunmi_water_purifier.tds_in() <= 51 THEN filter_water() yunmi_water_purifier"
