{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 500 THEN brightness_up() wotie_brightness_sensor",
    "IF aqara_temperature_sensor.reading() > 28 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF mijia_CO2_ultra_sensor.get_CO2_concentration() > 16 THEN turn_on() xiaomi_air_purifier",
    "IF xiaomi_volume_sensor.reading() > 45 THEN set_volume_low() xiaomi_television",
    "IF xiaomi_humidity_sensor.relative_humidity() < 38 THEN turn_on() zhimi_humidifier",
    "IF aqara_motion_sensor.motion_state() == true THEN turn_on() xiaomi_diffuser",
    "IF yunmi_water_purifier.tds_in() <= 74 THEN filter_water() yunmi_water_purifier"
  ],
