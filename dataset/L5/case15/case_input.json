{
  "user_input": [
    "IF wotie_brightness_sensor.brightness() < 632 THEN brightness_up() wotie_brightness_sensor",
    "IF aqara_temperature_sensor.reading() > 19 THEN turn_cool_on() xiaomi_air_conditioner",
    "IF qingping_air_monitor.reading_PM2_5() < 65 THEN turn_on() zhimi_air_fresh",
    "IF aqara_motion_sensor.motion_state() == true THEN set_volume_low() xiaomi_television",
    "IF xiaomi_humidity_sensor.relative_humidity() < 13 THEN turn_on() zhimi_humidifier",
    "IF aqara_motion_sensor.motion_state() == false THEN start_sweep() viomi_vacuum",
    "IF yunmi_water_purifier.tds_in() <= 89 THEN turn_on() yunmi_water_purifier"
  ],
